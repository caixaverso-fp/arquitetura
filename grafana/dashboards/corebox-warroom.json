   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({job=\"corebox\",tipo=\"access\"} | regexp \"dur_ms=(?P<d>[0-9]+)\" | unwrap d | __error__=\"\" | d > 1000 [1m]))",
     "queryType": "range",
     "legendFormat": "lentas>1s"
    }
   ],
